#:kivy 2.3.1

# ==============================================================================
# PRONTO CASINO UCT - HOJA DE ESTILOS INSTITUCIONAL (CSS equivalente en Kivy)
# Universidad Católica de Temuco • Casino Central TEC UCT
# Paleta de Colores:
#   - Azul Primario UCT:    #0A3871 (rgba: 0.04, 0.22, 0.44, 1.0)
#   - Celeste Institucional:#0288D1 (rgba: 0.01, 0.53, 0.82, 1.0)
#   - Azul Hielo Suave:     #E1F5FE (rgba: 0.88, 0.96, 0.99, 1.0)
#   - Blanco Puro:          #FFFFFF (rgba: 1.0,  1.0,  1.0,  1.0)
#   - Fondo de Pantalla:    #F4F8FC (rgba: 0.95, 0.97, 0.99, 1.0)
#   - Gris de Contorno:     #DFEAF2 (rgba: 0.87, 0.92, 0.95, 1.0)
# ==============================================================================

<MDScreen>:
    md_bg_color: 0.95, 0.97, 0.99, 1

<MDCard>:
    elevation: 0
    shadow_color: 0, 0, 0, 0
    shadow_softness: 0
    line_color: 0.88, 0.92, 0.96, 1

# Tarjeta Base con Contorno Sutil y Cero Sombras Glitch
<UCTCard@MDCard>:
    style: "outlined"
    theme_bg_color: "Custom"
    md_bg_color: 1.0, 1.0, 1.0, 1
    radius: [dp(14), dp(14), dp(14), dp(14)]
    line_color: 0.88, 0.92, 0.96, 1
    elevation: 0
    shadow_color: 0, 0, 0, 0
    padding: [dp(14), dp(10), dp(14), dp(10)]
    spacing: dp(4)

# Tarjeta de Autenticación / Credenciales
<UCTAuthCard@MDCard>:
    style: "outlined"
    theme_bg_color: "Custom"
    md_bg_color: 1.0, 1.0, 1.0, 1
    radius: [dp(16), dp(16), dp(16), dp(16)]
    line_color: 0.82, 0.88, 0.95, 1
    elevation: 0
    shadow_color: 0, 0, 0, 0
    padding: [dp(18), dp(18), dp(18), dp(18)]
    spacing: dp(10)

# Barra Superior Institucional
<UCTTopBar@MDBoxLayout>:
    size_hint_y: None
    height: dp(54)
    padding: [dp(14), dp(8), dp(14), dp(8)]
    spacing: dp(8)
    md_bg_color: 0.04, 0.22, 0.44, 1  # Azul UCT #0A3871

# Barra Inferior Navegación
<UCTBottomNav@MDBoxLayout>:
    size_hint_y: None
    height: dp(54)
    padding: [dp(8), dp(6), dp(8), dp(6)]
    spacing: dp(6)
    md_bg_color: 1.0, 1.0, 1.0, 1
